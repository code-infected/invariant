{
  "name": "@invariant/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "invariant": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "validate": "tsx src/index.ts validate",
    "test": "node --test \"dist/**/*.test.js\"",
    "schema:trial-trace": "tsx src/schema/write-trial-trace-schema.ts"
  },
  "dependencies": {
    "@invariant/agent-driver": "*",
    "@invariant/mcp-proxy": "*",
    "@invariant/scoring": "*",
    "@invariant/toy-tool-server": "*",
    "@invariant/trace-store": "*",
    "commander": "^12.1.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "zod-to-json-schema": "^3.25.2"
  }
}
